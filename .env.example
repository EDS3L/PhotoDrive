# PhotoDrive — szablon zmiennych środowiskowych.
# Skopiuj do `.env` (`cp .env.example .env`) i wypełnij WŁASNYMI wartościami.
# `.env` jest w .gitignore — NIGDY nie commituj prawdziwych sekretów.
# Ten plik czyta docker-compose.yml (dev); prod bierze wartości z sekretów GitHub Actions.

# --- Baza danych (MySQL 8) ---
DATASOURCE_URL=jdbc:mysql://localhost:3306/photodrive
DATASOURCE_USERNAME=photodrive
DATASOURCE_PASSWORD=change-me

# --- Poczta (SMTP, STARTTLS na :587) ---
MAIL_HOST=smtp.example.com
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=change-me
# Skrzynka, na którą trafiają zapytania z formularza kontaktowego.
# Pominięte = trafiają na MAIL_USERNAME.
CONTACT_RECIPIENT=kontakt@example.com

# --- JWT ---
# Klucz HS256: base64 co najmniej 256-bitowego sekretu. Wygeneruj np.:
#   openssl rand -base64 32
TOKEN_SECRETKEY=change-me-base64-256-bit-secret
# TTL sesji w minutach (domyślnie 60, jeśli pominięte).
JWT_ACCESS_TTL_MINUTES=60

# --- Cookie sesji i origin (bezpieczeństwo) ---
# Atrybut `Secure` na cookie `pd_at`. NA PRODUKCJI ZAWSZE `true`.
# Lokalnie MUSI być `false`, jeśli wchodzisz po http:// — przeglądarka nie zapisze
# cookie z `Secure` na połączeniu nieszyfrowanym, więc logowanie "przejdzie",
# ale sesji nie będzie i nic nie zgłosi błędu.
# `docker compose` podstawia tu `false`, gdy zmienna jest pusta; `./gradlew bootRun`
# bierze domyślne `true` z application.yml, więc przy bootRun ustaw ją JAWNIE.
COOKIE_SECURE=false
# Originy, którym wolno wysyłać żądania zmieniające stan (anty-CSRF) i które przechodzą CORS.
# Lista po przecinku, bez ukośnika na końcu. Poza produkcją localhost jest ufany dodatkowo
# (flaga app.csrf.allow-localhost-origins), więc do lokalnej pracy nie trzeba nic zmieniać.
CSRF_ALLOWED_ORIGINS=https://photodrive.dev
# Adres publiczny aplikacji (używany do budowania odnośników).
APP_BASE_URL=http://localhost:8080

# --- Storage plików ---
# Katalog na oryginały i miniatury oraz katalog tymczasowy uploadu.
DIR=/app/photodrive/
STORAGE_TEMP_PATH=/app/photodrive-temp
# Całkowita pojemność magazynu plików w GB (NIE rozmiar pojedynczego uploadu).
# Upload jest odrzucany, gdy suma rozmiarów plików w bazie przekroczy ten limit; 0 = bez limitu.
ORG_MAX_SIZE=20

# --- Swagger UI (osobny login do /swagger-ui) ---
SWAGGER_USER=swagger
SWAGGER_PASSWORD=change-me
